#!/usr/bin/env bash
# Purpose: Runs guestfish locally or in the libguestfs container.
# Usage: guestfish [OPTIONS] [COMMAND [ARG...]]
#

# If a command list is passed via STDIN (see https://libguestfs.org/guestfish.1.html#from-shell-scripts):
# - redirect it to a file
# - pass it to guestfish as file (`-f`)
if [ ! -t 0 ]; then
  declare tmp
  tmp=$(mktemp "guestfish.XXXXXX")
  trap '[ ! -f "${tmp-}" ] || rm -- "$tmp"' EXIT
  cat - >"$tmp"
  set -- "$@" -f "$tmp"
fi

if command guestfish &>/dev/null; then
  command guestfish "$@"
elif command libguestfsw &>/dev/null; then
  command libguestfsw guestfish "$@"
else
  declare wrapper_source
  wrapper_source=$(curl -LfsS https://git.io/libguestfsw) || exit "$?"
  bash -c "$wrapper_source" -- guestfish "$@"
fi
